{
  "crons": [
    {
      "path": "/api/cron/google-sheet-sync",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "purelyjid-order-tracker\\.vercel\\.app"
        }
      ],
      "destination": "https://www.purelyjid.in/:path*",
      "permanent": true
    }
  ]
}
