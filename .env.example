# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Cron Security
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Internal staff order portal
STAFF_USERNAME=
STAFF_PASSWORD=
STAFF_SESSION_SECRET=

# Resin artist WhatsApp number: international digits only
RESIN_ARTIST_WHATSAPP_NUMBER=919876543210
RESIN_ARTIST_ACCEPTANCE_NOTIFY_NUMBER=

# Automatic acceptance email (Supabase UPDATE webhook -> Resend)
# Keep these server-side in Vercel; never put them in NEXT_PUBLIC variables.
ARTIST_ACCEPTANCE_WEBHOOK_SECRET=
RESEND_API_KEY=
ARTIST_ACCEPTANCE_EMAIL_FROM=PurelyJid <orders@your-verified-domain.example>
ARTIST_ACCEPTANCE_EMAIL_TO=

# Resin Artist workflow
RESIN_ARTIST_GOOGLE_SHEET_ID=
RESIN_ARTIST_GOOGLE_SHEET_TAB=Artist

# Canva - Vinyl Font Selector
# Initial/testing token. Production should use persistent OAuth refresh-token storage.
CANVA_ACCESS_TOKEN=
# 8-page Canva source design containing VINYL_TEXT autofill fields
CANVA_VINYL_DESIGN_ID=
